# Local marketing / research material at the repo root (not part of the app). Anchored with a leading slash so
# app folders that happen to share the name, such as packages/nextjs/services/marketing/, stay tracked.
/marketing/
/web3-master/

# Supabase CLI state: the linked project and cached service versions, written by `supabase link` and other commands.
# Machine-specific; the project id does not belong in the repo. A stray /supabase/ appears when the CLI runs from the
# repo root instead of packages/.
.temp/
/supabase/
