exports[`AdminPage markup > renders the not-deployed alert when the paywall has no deployment 1`] = `"<div class="mx-auto flex w-full max-w-3xl flex-col gap-6 px-5 py-6 md:px-6 md:py-10"><div class="flex flex-col gap-1"><h1 class="m-0 text-2xl font-medium tracking-tight text-foreground">Admin console</h1><p class="m-0 max-w-prose text-sm text-muted-foreground">Owner actions for the TokenpingPaywall contract, each sent as a transaction from the owner wallet.</p></div><div role="note" data-variant="destructive" class="flex w-full gap-3 rounded-xl border p-4 text-left text-sm text-foreground border-destructive/30 bg-destructive-subtle"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-alert lucide-alert-circle mt-0.5 size-5 shrink-0 text-destructive" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg><div class="flex min-w-0 flex-1 flex-col gap-1"><div class="font-medium text-foreground">Contract not deployed</div><div class="text-sm text-muted-foreground [&amp;_a]:text-link [&amp;_a]:underline [&amp;_a]:underline-offset-4 [&amp;_p]:m-0">TokenpingPaywall is not deployed on any configured target network.</div></div></div></div>"`;

