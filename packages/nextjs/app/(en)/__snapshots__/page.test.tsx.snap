<h2 id="how-it-works-title" class="text-section mb-0 text-balance">How it works</h2>
</header>
<div>
<ol class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-4">
<li class="rounded-2xl border border-border bg-card p-5 text-card-foreground shadow-card md:p-7 m-0 flex flex-col gap-3">
<span class="flex items-center justify-between gap-3">
<span aria-hidden="true" class="flex size-10 shrink-0 items-center justify-center rounded-full bg-brand-plum text-brand-white dark:outline dark:outline-border">
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-wallet size-5" aria-hidden="true">
