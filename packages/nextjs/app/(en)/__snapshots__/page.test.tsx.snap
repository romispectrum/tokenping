</path>
<path d="M15 6h1v4">
</path>
<path d="m6.134 14.768.866-.5 2 3.464">
</path>
<circle cx="16" cy="8" r="6">
</circle>
</svg>
</span>
<span aria-hidden="true" class="font-data text-sm font-bold text-muted-foreground tabular-nums">2</span>
</span>
<h3 class="m-0 text-base leading-snug font-medium">
<span class="sr-only">2.</span> Unlock alerts for 3 USDC</h3>
<p class="m-0 text-sm leading-relaxed text-muted-foreground">30 days, paid in USDC on Arbitrum One. No auto-renew.</p>
</li>
<li class="rounded-2xl border border-border bg-card p-5 text-card-foreground shadow-card md:p-7 m-0 flex flex-col gap-3">
<span class="flex items-center justify-between gap-3">
<span aria-hidden="true" class="flex size-10 shrink-0 items-center justify-center rounded-full bg-brand-plum text-brand-white dark:outline dark:outline-border">
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sliders-horizontal size-5" aria-hidden="true">
<path d="M10 5H3">
</path>
