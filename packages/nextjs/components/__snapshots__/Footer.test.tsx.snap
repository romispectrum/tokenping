</li>
<li class="m-0 flex p-0">
<a href="https://t.me/tokenping_xyz" class="inline-flex min-h-8 items-center rounded-sm text-sm text-muted-foreground underline-offset-4 transition-colors duration-150 ease-[ease] hover:text-foreground hover:underline pointer-coarse:min-h-11" aria-label="Tokenping Telegram community" target="_blank" rel="noopener noreferrer">Telegram</a>
</li>
</ul>
</div>
<div>
<h2 id="footer-legal" class="m-0 text-sm font-medium text-foreground">Legal</h2>
<ul aria-labelledby="footer-legal" class="m-0 mt-3 flex list-none flex-col gap-1 p-0 md:mt-4">
<li class="m-0 flex p-0">
<a class="inline-flex min-h-8 items-center rounded-sm text-sm text-muted-foreground underline-offset-4 transition-colors duration-150 ease-[ease] hover:text-foreground hover:underline pointer-coarse:min-h-11" href="/privacy">Privacy</a>
</li>
</ul>
</div>
</nav>
</div>
<div class="mx-auto w-full max-w-[1200px] pr-[max(1.25rem,env(safe-area-inset-right))] pl-[max(1.25rem,env(safe-area-inset-left))]">
<div class="flex flex-col gap-4 border-t border-border pt-6 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between pb-[max(2.5rem,env(safe-area-inset-bottom))]">
<p class="m-0">Independent tool, not affiliated with Aave Labs or the Aave DAO.</p>
<div class="flex flex-wrap items-center gap-x-6 gap-y-3">
<div data-stub="theme-choice">
</div>
</div>
</div>
</div>
</div>
</footer>"
`;

