exports[`AccessPaywall markup > offers a network switch on the wrong chain 1`] = `"<div class="flex flex-col gap-4"><div data-slot="card" data-size="default" class="card group/card gap-4 overflow-hidden rounded-2xl border border-border bg-card text-sm text-card-foreground py-[var(--card-spacing)] has-[>[data-slot=card-footer]]:pb-0 [--card-spacing:1.25rem] sm:[--card-spacing:1.5rem]"><div class="flex items-start gap-3 px-[var(--card-spacing)]"><div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-muted text-muted-foreground"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock size-5" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg></div><div class="flex min-w-0 flex-col gap-1"><h3 class="m-0 text-base font-medium text-foreground">Unlock health factor alerts</h3><p class="m-0 text-sm text-muted-foreground">Pay once to unlock alert settings and set a health factor threshold for each network. Nothing renews automatically: you pay from your wallet when you want to extend.</p></div></div><div class="flex flex-col gap-4 px-[var(--card-spacing)]"><div role="note" data-variant="warning" class="flex w-full gap-3 rounded-xl border p-4 text-left text-sm text-foreground border-warning/30 bg-warning-subtle"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-triangle-alert lucide-alert-triangle mt-0.5 size-5 shrink-0 text-warning" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg><div class="flex min-w-0 flex-1 flex-col gap-1"><div class="font-medium text-fore