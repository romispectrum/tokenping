ria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 aria-disabled:pointer-events-none not-aria-busy:aria-disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*='size-'])]:size-4 btn-primary border-transparent hover:[--btn-bg:var(--color-primary)] hover:brightness-110 motion-safe:hover:-translate-y-0.5 disabled:bg-primary! disabled:text-primary-foreground px-4 text-sm pointer-coarse:min-h-11 w-full">Pay 1.5 USDC</button><p id="«id»" class="m-0 flex items-start gap-2 text-sm text-foreground"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-triangle-alert lucide-alert-triangle mt-0.5 size-4 shrink-0 text-warning" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg><span>Payments are paused right now. Try again later.</span></p><div id="«id»" role="status" aria-live="polite" aria-atomic="true"></div></div></div><div>child</div></div>"`;
