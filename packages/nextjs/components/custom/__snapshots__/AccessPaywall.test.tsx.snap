exports[`AccessPaywall actions > keeps Pay busy and focused, and ignores clicks, until the approval is mined and paid 1`] = `"<div class="flex flex-col gap-4"><div data-slot="card" data-size="default" class="card group/card gap-4 overflow-hidden rounded-2xl border border-border bg-card text-sm text-card-foreground py-[var(--card-spacing)] has-[>[data-slot=card-footer]]:pb-0 [--card-spacing:1.25rem] sm:[--card-spacing:1.5rem]"><div class="flex items-start gap-3 px-[var(--card-spacing)]"><div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-muted text-muted-foreground"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock size-5" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg></div><div class="flex min-w-0 flex-col gap-1"><h3 class="m-0 text-base font-medium text-foreground">Unlock health factor alerts</h3><p class="m-0 text-sm text-muted-foreground">Pay once to unlock alert settings and set a health factor threshold for each network. Nothing renews automatically: you pay from your wallet when you want to extend.</p></div></div><div class="flex flex-col gap-4 px-[var(--card-spacing)]"><dl class="m-0 divide-y divide-border rounded-xl border border-border text-sm"><div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 px-4 py-3"><dt class="text-muted-foreground">Price</dt><dd class="m-0 text-right text-foreground"><span class="font-bold tabular-nums">1.5</span> <span class="font-medium text-muted-foreground">USDC</span></dd></div><div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 px-4 py-3"><dt class="text-muted-foreground">Access</dt><dd class="m-0 text-right text-foreground">30 days</dd></div><div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 px-4 py-3"><dt class="text-muted-foreground">Network</dt><dd class="m-0 text-right text-foreground"><span class="inline-flex h-7 max-w-full items-center gap-2 rounded-full px-3 text-sm font-medium whitespace-nowrap bg-secondary text-secondary-foreground"><span aria-hidden="true" class="size-2 shrink-0 rounded-full bg-success"></span><span class="truncate">Arbitrum One</span></span></dd></div><div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 px-4 py-3"><dt class="text-muted-foreground">Network fee</dt><dd class="m-0 text-right text-foreground">Paid in ETH for each step, shown in your wallet</dd></div></dl><ol aria-label="Payment steps" class="m-0 flex list-none flex-col gap-3 p-0"><li class="m-0 flex items-start gap-3" aria-current="step"><span aria-hidden="true" class="flex size-6 shrink-0 items-center justify-center rounded-full text-xs font-medium bg-info-subtle text-info"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-loader-circle lucide-loader-2 size-4 animate-spin motion-reduce:animate-none" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg></span><span class="flex min-w-0 flex-col gap-0.5 text-sm"><span class="flex flex-wrap items-baseline gap-x-2"><span class="font-medium text-foreground">Approve 1.5 USDC</span><span class="text-muted-foreground"><span class="sr-only">, </span>In progress</span></span><span class="text-muted-foreground">Lets the paywall take exactly this amount. Skipped when an earlier approval covers it.</span></span></li><li class="m-0 flex items-start gap-3"><span aria-hidden="true" class="flex size-6 shrink-0 items-center justify-center rounded-full text-xs font-medium border border-input text-foreground tabular-nums">2</span><span class="flex min-w-0 flex-col gap-0.5 text-sm"><span class="flex flex-wrap items-baseline gap-x-2"><span class="font-medium text-foreground">Pay 1.5 USDC</span></span><span class="text-muted-foreground">Sends the payment and unlocks alerts.</span></span></li></ol><button type="button" class="btn gap-2 font-medium whitespace-nowrap transition-[color,background-color,border-color,box-shadow,filter,translate] duration-200 ease-[ease] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 aria-disabled:pointer-events-none not-aria-busy:aria-disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*='size-'])]:size-4 btn-primary border-transparent hover:[--btn-bg:var(--color-primary)] hover:brightness-110 motion-safe:hover:-translate-y-0.5 disabled:bg-primary! disabled:text-primary-foreground px-4 text-sm pointer-coarse:min-h-11 w-full" aria-disabled="true" aria-busy="true"><span class="inline-grid"><span aria-hidden="true" class="invisible col-start-1 row-start-1 inline-flex items-center justify-center gap-2">Pay 1.5 USDC</span><span class="col-start-1 row-start-1 inline-flex items-center justify-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-loader-circle lucide-loader-2 animate-spin motion-reduce:animate-none" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>Approving</span></span></button><div id="«id»" role="status" aria-live="polite" aria-atomic="true" data-step="approve-pending" class="flex items-start gap-3 rounded-xl border p-4 text-sm text-foreground border-info/30 bg-info-subtle"><span class="mt-px shrink-0 text-info"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-loader-circle lucide-loader-2 size-5 animate-spin motion-reduce:animate-none" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg></span><div class="flex min-w-0 flex-1 flex-col gap-1"><p class="m-0 font-medium">Processing on Arbitrum One</p><p class="m-0 text-muted-foreground">Step 1 of 2: approval submitted. Your wallet asks you to confirm the payment next.</p><p class="m-0 flex flex-wrap items-center gap-x-3 gap-y-1 pt-1"><span class="font-data text-sm text-muted-foreground" title="0xapprove"><span class="sr-only">Transaction </span>0xapprove</span><a href="https://arbiscan.io/tx/0xapprove" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 font-medium text-link underline underline-offset-3 hover:decoration-2 pointer-coarse:min-h-11">View on Arbiscan<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link size-3.5" aria-hidden="true"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg><span class="sr-only">(opens in a new tab)</span></a></p></div></div></div></div><div>child</div></div>"`;

