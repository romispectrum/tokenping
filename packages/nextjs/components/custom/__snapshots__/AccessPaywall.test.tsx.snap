exports[`AccessPaywall markup > shows the expiry date and children when access is active 1`] = `"<div class="flex flex-col gap-4"><p class="m-0 flex items-center gap-2 text-sm text-muted-foreground"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check lucide-check-circle-2 size-4 shrink-0 text-success" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg><span>Alerts unlocked until <DATE></span></p><div class="flex flex-col items-start gap-2"><button aria-describedby="«id»" type="button" class="btn gap-2 font-medium whitespace-nowrap transition-[color,background-color,border-color,box-shadow,filter,translate] duration-200 ease-[ease] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 aria-disabled:pointer-events-none not-aria-busy:aria-disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*='size-'])]:size-4 border-input bg-background text-foreground hover:bg-accent hover:text-accent-foreground aria-expanded:bg-accent aria-expanded:text-accent-foreground disabled:bg-background! btn-sm px-3 text-sm pointer-coarse:min-h-11">Add 30 days for 1.5 USDC</button><p id="«id»" class="m-0 text-sm text-muted-foreground">Each payment adds 30 days after your current end date. Pay as many times as you like; nothing renews on its own.</p><div id="«id»" role="status" aria-live="polite" aria-atomic="true"></div></div><div>child</div></div>"`;

exports[`AccessPaywall markup > shows the price and an enabled pay button when ready 1`] = `"<div class="flex flex-col gap-4"><div data-slot="card" data-size="default" class="card group/card gap-4 overflow-hidden rounded-2xl border border-border bg-card text-sm text-card-foreground py-[var(--card-spacing)] has-[>[data-slot=card-footer]]:pb-0 [--card-spacing:1.25rem] sm:[--card-spacing:1.5rem]"><div class="flex items-start gap-3 px-[var(--card-spacing)]"><div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-muted text-muted-foreground"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock size-5" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg></div><div class="flex min-w-0 flex-col gap-1"><h3 class="m-0 text-base font-medium text-foreground">Unlock health factor alerts</h3><p class="m-0 text-sm text-muted-foreground">Pay once to unlock alert settings and set a health factor threshold for each network. Nothing renews automatically: you pay from your wallet when you want to extend.</p></div></div><div class="flex flex-col gap-4 px-[var(--card-spacing)]"><dl class="m-0 divide-y divide-border rounded-xl border border-border text-sm"><div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 px-4 py-3"><dt class="text-muted-foreground">Price</dt><dd class="m-0 text-right text-foreground"><span class="font-bold tabular-nums">1.5</span> <span class="font-medium text-muted-foreground">USDC</span></dd></div><div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 px-4 py-3"><dt class="text-muted-foreground">Access</dt><dd class="m-0 text-right text-foreground">30 days</dd></div><div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 px-4 py-3"><dt class="text-muted-foreground">