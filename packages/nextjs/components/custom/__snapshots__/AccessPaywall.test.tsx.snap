sabled:opacity-50 aria-disabled:pointer-events-none not-aria-busy:aria-disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*='size-'])]:size-4 btn-primary border-transparent hover:[--btn-bg:var(--color-primary)] hover:brightness-110 motion-safe:hover:-translate-y-0.5 disabled:bg-primary! disabled:text-primary-foreground px-4 text-sm pointer-coarse:min-h-11 w-full">Pay 1.5 USDC</button><div id="«id»" role="status" aria-live="polite" aria-atomic="true"></div></div></div><div>child</div></div>"`;

