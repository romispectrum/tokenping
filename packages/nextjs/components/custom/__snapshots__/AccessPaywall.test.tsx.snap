exports[`AccessPaywall markup > asks to connect a wallet first 1`] = `"<div class="space-y-4"><div class="rounded-xl border border-warning/40 bg-base-100 dark:border-amber-500/30 dark:bg-gradient-to-br dark:from-amber-950/20 dark:to-gray-900/50 backdrop-blur-xl p-5"><div class="flex flex-col items-center text-center"><div class="mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-amber-500/20"><svg class="h-6 w-6 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg></div><h3 class="mb-1 text-sm font-semibold text-base-content dark:text-white">Pay for access to configure notifications</h3><p class="mb-4 max-w-[280px] text-xs text-base-content/70 dark:text-gray-400">Pay once to unlock notification settings. You set health factor alerts per network. No auto-charges—you pay from your wallet when you want to extend.</p><p class="text-xs text-amber-400">Connect your wallet to pay for access.</p></div></div><div>child</div></div>"`;

