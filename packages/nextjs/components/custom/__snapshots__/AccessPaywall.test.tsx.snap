exports[`AccessPaywall markup > hides the expiry line when the expiry timestamp is zero 1`] = `"<div class="flex flex-col gap-4"><div class="flex flex-col items-start gap-2"><button aria-describedby="«id»" type="button" class="btn gap-2 font-medium whitespace-nowrap transition-[color,background-color,border-color,box-shadow,filter,translate] duration-200 ease-[ease] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 aria-disabled:pointer-events-none not-aria-busy:aria-disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*='size-'])]:size-4 border-input bg-background text-foreground hover:bg-accent hover:text-accent-foreground aria-expanded:bg-accent aria-expanded:text-accent-foreground disabled:bg-background! btn-sm px-3 text-sm pointer-coarse:min-h-11">Add 30 days for 1.5 USDC</button><p id="«id»" class="m-0 text-sm text-muted-foreground">Each payment adds 30 days after your current end date. Pay as many times as you like; nothing renews on its own.</p><div id="«id»" role="status" aria-live="polite" aria-atomic="true"></div></div><div>child</div></div>"`;

