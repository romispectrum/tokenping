exports[`notification settings markup > renders the threshold field: slider without fill, exact value input named by the visible label 1`] = `
<div
  class="flex flex-col gap-2"
>
  <label
    class="w-fit text-sm leading-snug font-medium text-foreground"
    for="id1-slider"
    id="id1-label"
  >
    Health factor threshold
  </label>
  <div
    class="flex items-center gap-3"
  >
    <input
      aria-describedby="id1-description"
      aria-valuetext="1.8"
      class="range min-w-0 flex-1 text-link [--range-bg:var(--input)] [--range-fill:0] pointer-coarse:h-11"
      id="id1-slider"
      max="3.0"
      min="1.1"
      step="0.1"
      type="range"
      value="1.8"
    />
    <div
      class="w-24 shrink-0"
    >
      <span
        hidden=""
        id="id1-exact"
      >
        (exact value)
      </span>
      <input
        aria-describedby="id1-description"
        aria-labelledby="id1-label id1-exact"
        class="input w-full min-w-0 border border-input bg-background px-3 text-base text-foreground md:text-sm placeholder:text-muted-foreground transition-[border-color,box-shadow] duration-200 ease-[ease] pointer-coarse:min-h-11 focus-visible:border-ring focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring aria-invalid:border-destructive disabled:cursor-not-allowed disabled:opacity-50 read-only:bg-muted text-right tabular-nums"
        data-slot="input"
        inputmode="decimal"
        type="text"
        value="1.80"
      />
    </div>
  </div>
  <div
    class="grid grid-cols-3 gap-2 text-sm text-muted-foreground"
  >
    <span
      class="flex flex-col items-start text-left"
    >
      <span>
        1.1
      </span>
      <span>
        Critical
      </span>
    </span>
    <span
      class="flex flex-col items-center text-center"
    >
      <span>
        2.0
      </span>
      <span>
        Safe
      </span>
    </span>
    <span
      class="flex flex-col items-end text-right"
    >
      <span>
        3.0
      </span>
      <span>
        Very safe
      </span>
    </span>
  </div>
  <p
    class="m-0 text-sm text-muted-foreground"
    id="id1-description"
  >
    You'll
     be notified when your health factor drops below 
    1.8
     on 
    Arbitrum
    .
  </p>
</div>
`;
