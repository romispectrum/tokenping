# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/
.vercel

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# typescript
*.tsbuildinfo

ipfs-upload.config.json

# Satoshi (Indian Type Foundry): its license allows using it on our own site but forbids passing the files on,
# repositories included. `yarn next:fonts` downloads the official files from Fontshare (scripts/fetchFonts.ts), and
# `yarn build`, `yarn dev` and `yarn test` run it first.
/app/fonts/Satoshi-*
/app/fonts/og/Satoshi-*
