{
  "name": "@se-2/nextjs",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "next build",
    "check-types": "tsc --noEmit --incremental",
    "dev": "next dev",
    "format": "prettier --write . '!(node_modules|.next|contracts)/**/*'",
    "lint": "next lint",
    "serve": "next start",
    "start": "next dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "token-icons": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/fetchTokenIcons.ts",
    "network-icons": "tsx scripts/fetchNetworkIcons.ts",
    "indexnow": "tsx scripts/submitIndexNow.ts",
    "telegram-webhook": "bash scripts/telegram-webhook.sh",
    "vercel": "vercel --build-env YARN_ENABLE_IMMUTABLE_INSTALLS=false --build-env ENABLE_EXPERIMENTAL_COREPACK=1 --build-env VERCEL_TELEMETRY_DISABLED=1",
    "vercel:yolo": "vercel --build-env YARN_ENABLE_IMMUTABLE_INSTALLS=false --build-env ENABLE_EXPERIMENTAL_COREPACK=1 --build-env NEXT_PUBLIC_IGNORE_BUILD_ERROR=true --build-env VERCEL_TELEMETRY_DISABLED=1",
    "ipfs": "NEXT_PUBLIC_IPFS_BUILD=true yarn build && yarn bgipfs upload config init -u https://upload.bgipfs.com && CID=$(yarn bgipfs upload out | grep -o 'CID: [^ ]*' | cut -d' ' -f2) && [ ! -z \"$CID\" ] && echo '🚀 Upload complete! Your site is now available at: https://community.bgipfs.com/ipfs/'$CID || echo '❌ Upload failed'",
    "vercel:login": "vercel login"
  },
  "dependencies": {
    "@heroicons/react": "^2.1.5",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "15.5.9",
    "@rainbow-me/rainbowkit": "2.2.9",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@scaffold-ui/components": "^0.1.8",
    "@scaffold-ui/debug-contracts": "^0.1.7",
    "@scaffold-ui/hooks": "^0.1.6",
    "@supabase/supabase-js": "^2.47.0",
    "@tanstack/react-query": "^5.59.15",
    "@vercel/analytics": "^2.0.1",
    "blo": "^1.2.0",
    "burner-connector": "0.0.20",
    "daisyui": "^5.0.9",
    "hast-util-from-html": "2.0.3",
    "hast-util-to-mdast": "10.1.2",
    "kubo-rpc-client": "^5.0.2",
    "lucide-react": "1.48.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-markdown": "2.2.0",
    "next": "^15.2.8",
    "next-nprogress-bar": "^2.3.13",
    "next-themes": "0.4.6",
    "qrcode.react": "^4.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hot-toast": "^2.4.0",
    "remark-gfm": "4.0.1",
    "resend": "^6.9.2",
    "server-only": "0.0.1",
    "sitemap": "10.0.0",
    "usehooks-ts": "^3.1.0",
    "viem": "2.39.0",
    "wagmi": "2.19.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@tailwindcss/postcss": "latest",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/mdx": "2.0.13",
    "@types/node": "^18.19.50",
    "@types/react": "^19.0.7",
    "@types/react-dom": "19.1.11",
    "abitype": "1.0.6",
    "bgipfs": "^0.0.12",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.3",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.4",
    "jsdom": "29.1.1",
    "postcss": "^8.4.45",
    "prettier": "^3.5.3",
    "sharp": "0.35.5",
    "tailwindcss": "^4.1.3",
    "tsx": "4.23.15",
    "type-fest": "^4.26.1",
    "typescript": "^5.8.2",
    "vercel": "^39.1.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "packageManager": "yarn@3.2.3"
}
