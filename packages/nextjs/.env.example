# Template for NextJS environment variables.

# For local development, copy this file, rename it to .env.local, and fill in the values.
# When deploying live, you'll need to store the vars in Vercel/System config.

# If not set, we provide default values (check `scaffold.config.ts`) so developers can start prototyping out of the box,
# but we recommend getting your own API Keys for Production Apps.

# To access the values stored in this env file you can use: process.env.VARIABLENAME
# You'll need to prefix the variables names with NEXT_PUBLIC_ if you want to access them on the client side.
# More info: https://nextjs.org/docs/pages/building-your-application/configuring/environment-variables
NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Supabase (see packages/supabase/README.md). The server reaches Supabase only with the service-role key: every table
# is closed to the anon key, so there is no SUPABASE_ANON_KEY.
# SUPABASE_URL:               The project's API URL. Defaults to http://localhost:54321 (`supabase start`); required in
#                             a Vercel production deployment.
# SUPABASE_SERVICE_ROLE_KEY:  Required in production and for any hosted project; server only, never prefix it with
#                             NEXT_PUBLIC_. Against a local stack it can stay empty: the server then uses the demo
#                             service-role key every `supabase start` shares. Where it is needed and missing, every
#                             API route that reads or writes the database answers 500 and logs that it is not set.
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=

#Resend for send-email API (defaults to Resend onboarding address)
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@tokenping.xyz

# Bearer secret for server-to-server routes.
# Required for /api/send-email (503 without it).
# Recommended for /api/cron/notifications, which otherwise falls back to spoofable Vercel cron headers
# and logs a warning each run.
CRON_SECRET=

# Public app URL used by server-side API calls (recommended in production)
# Example: https://tokenping.xyz
NEXT_PUBLIC_APP_URL=

# Signal notifications via signal-cli-rest-api (https://github.com/bbernhard/signal-cli-rest-api)
# Deploy the Docker container on Fly.io / Railway / any VPS (see docs/signal-server-fly.md), then fill in these vars.
# SIGNAL_API_URL:       Base URL of your signal-cli-rest-api instance, e.g. https://signal.example.com
# SIGNAL_SENDER_NUMBER: Registered Signal sender phone number in E.164 format, e.g. +14155550123
# SIGNAL_API_TOKEN:     The relay's shared secret, sent as "Authorization: Bearer <token>". Must match the
#                       SIGNAL_API_TOKEN secret on the relay. Generate one with: openssl rand -hex 32
SIGNAL_API_URL=
SIGNAL_SENDER_NUMBER=
SIGNAL_API_TOKEN=

# Telegram notifications via Bot API (https://core.telegram.org/bots/api).
# Create a bot with @BotFather, then fill in:
# TELEGRAM_BOT_TOKEN:              Bot token from @BotFather (e.g. 1234567890:ABC-DEF...)
# TELEGRAM_WEBHOOK_SECRET:         A random string you choose. Pass to setWebhook as secret_token.
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME: Bot username without @ (e.g. TokenpingBot). The alert form links people to
#                                    it to press Start once; the site offers Telegram only while it is set.
# See docs/telegram-bot-setup.md for setup steps.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# SEO (read at build time; changing them needs a redeploy).
# NEXT_PUBLIC_SITE_URL:  Origin for canonicals, sitemap, RSS and JSON-LD. Defaults to https://tokenping.xyz, so leave it
#                        empty unless the site moves; previews and local builds still point canonicals at production.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION / NEXT_PUBLIC_BING_SITE_VERIFICATION: Search Console / Bing Webmaster meta-tag
#                        tokens. Not needed if the domain is verified by a DNS TXT record (preferred for Google).
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Token icon refresh (`yarn next:token-icons`, scripts/fetchTokenIcons.ts). Not read by the app.
# COINGECKO_API_KEY: Optional CoinGecko Demo key (no charge). Raises the rate limit of the per-address lookups.
COINGECKO_API_KEY=
